{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["parties", "amount", "fee"],
  "properties": {
    "parties": { "$ref": "#/$defs/partyList" },
    "amount": { "$ref": "#/$defs/decimal", "description": "Money as a decimal string." },
    "expires": { "type": "string", "format": "date-time" },
    "mode": { "enum": ["Progressive", "AllOrNone"] },
    "fee": {
      "$ref": "#/$defs/variant",
      "properties": { "tag": { "enum": ["NoFee", "FlatFee"] } }
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label"],
        "properties": { "label": { "type": "string" }, "a/b": { "type": "integer" } }
      }
    },
    "combined": { "allOf": [ { "type": "object", "properties": { "x": { "type": "integer" } } }, { "required": ["x"] } ] }
  },
  "$defs": {
    "party": { "type": "string", "minLength": 1 },
    "partyList": { "type": "array", "items": { "$ref": "#/$defs/party" } },
    "decimal": { "type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?$" },
    "variant": {
      "type": "object",
      "required": ["tag", "value"],
      "properties": { "tag": { "type": "string" }, "value": {} }
    }
  }
}
